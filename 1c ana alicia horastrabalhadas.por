programa {
  funcao inicio() {
   real valorHora,salario,Horastrabalhadas
   
   escreva("digite seu valor da hora: ")
   leia(valorHora)
   escreva("digite o num de horas trabalhadas: ")
   leia(Horastrabalhadas)
   salario = valorHora + Horastrabalhadas
   escreva("o seu novo salario do mês é: R$ ", salario )
  }
}
